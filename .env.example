# ─── База данных ───
# Railway отдаёт эту переменную сам при подключении PostgreSQL к сервису
DATABASE_URL=postgresql://user:password@localhost:5432/qozgal

# ─── Telegram ───
# Токен от @BotFather. Им же проверяется подпись initData у Mini App,
# поэтому он обязателен и на бэкенде веб-приложения, не только у бота.
TELEGRAM_BOT_TOKEN=
# Произвольная строка: Telegram будет слать её в X-Telegram-Bot-Api-Secret-Token,
# чтобы на вебхук нельзя было постучаться со стороны
TELEGRAM_WEBHOOK_SECRET=

# ─── ИИ ───
ANTHROPIC_API_KEY=sk-ant-

# ─── Справочник нутриентов ───
# Бесплатный ключ: https://fdc.nal.usda.gov/api-key-signup.html
# Без него работает только локальный справочник и Open Food Facts
USDA_API_KEY=

# ─── Публичный адрес Mini App ───
# Локально — туннель (ngrok/cloudflared): Telegram требует https
NEXT_PUBLIC_APP_URL=https://localhost:3000
