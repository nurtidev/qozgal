    "test": "tsx --test \"src/**/*.test.ts\"",
    "bot": "tsx src/bot/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:deploy": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/migrate.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/seed.ts",
    "bench:photo": "tsx src/bench.ts",
    "bench:text": "tsx src/bench-text.ts",
    "shot": "tsx e2e/shot.ts",
    "test:api": "tsx --test e2e/api.test.ts",
    "audit:foods": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/audit-foods.ts",
    "audit:weights": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/audit-weights.ts",
    "probe:usda": "node --env-file-if-exists=.env node_modules/.bin/tsx src/probe-usda.ts",
    "audit:cache": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/audit-cache.ts",
    "audit:recipes": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/audit-recipes.ts",
    "audit:gaps": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/audit-gaps.ts",
    "db:cleanup": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/cleanup-prod.ts",
    "deploy:status": "tsx tools/deploy-status.ts"
  },
  "overrides": {
    "valibot": "^1.4.2",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
