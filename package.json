    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "telegram": "^2.26.22",
    "typescript": "^5"
  }
